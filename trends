def fetch_trends_data(plant_names, state_code, retries=3, backoff=2.0):
    """
    Fetch Google Trends interest over time for a list of plant names,
    geo-filtered to the given US state. Returns a dict of plant_name -> score.
    Handles rate limiting with exponential backoff.
    pytrends accepts max 5 keywords per request so we batch accordingly.
    """
    if TrendReq is None:
        raise RuntimeError("pytrends is not installed")

    results = {}
    geo = f"US-{state_code}"

    # Batch into groups of 5 (pytrends limit)
    batches = [plant_names[i:i+5] for i in range(0, len(plant_names), 5)]

    pytrends = TrendReq(hl="en-US", tz=360, timeout=(10, 25), retries=2, backoff_factor=0.5)

    for batch in batches:
        for attempt in range(retries):
            try:
                pytrends.build_payload(
                    batch,
                    cat=0,
                    timeframe="today 3-m",
                    geo=geo,
                    gprop=""
                )
                interest_df = pytrends.interest_over_time()

                if interest_df.empty:
                    for name in batch:
                        results[name] = {"score": 0, "slope": "insufficient_data"}
                else:
                    for name in batch:
                        if name in interest_df.columns:
                            series = interest_df[name].dropna()
                            if len(series) >= 4:
                                score = int(series.mean())
                                # Calculate slope: compare last quarter vs first quarter of period
                                half = len(series) // 2
                                first_half_avg = series.iloc[:half].mean()
                                second_half_avg = series.iloc[half:].mean()
                                delta = second_half_avg - first_half_avg
                                if delta > 8:
                                    slope = "rising"
                                elif delta > 3:
                                    slope = "climbing"
                                elif delta < -8:
                                    slope = "falling"
                                elif delta < -3:
                                    slope = "declining"
                                else:
                                    slope = "stable"
                            else:
                                score = 0
                                slope = "insufficient_data"
                            results[name] = {"score": score, "slope": slope}
                        else:
                            results[name] = {"score": 0, "slope": "no_data"}

                # Respect rate limits between batches
                time.sleep(1.5)
                break  # Success, exit retry loop

            except Exception as e:
                if attempt < retries - 1:
                    time.sleep(backoff * (attempt + 1))
                else:
                    # On final failure, mark all plants in batch as unavailable
                    for name in batch:
                        results[name] = {"score": 0, "slope": "fetch_error", "error": str(e)}

    return results


def handler(request):
    """
    Vercel serverless handler.
    Expects GET params: category, state
    Returns JSON with trend scores for the plant list for that category/state.
    """
    # Parse query params
    parsed = urllib.parse.urlparse(request.path)
    params = urllib.parse.parse_qs(urllib.parse.urlparse(
        request.path + "?" + (request.query_string.decode() if hasattr(request, "query_string") else "")
    ).query)

    category = params.get("category", ["shrubs"])[0].lower()
    state = params.get("state", ["MN"])[0].upper()

    # Validate inputs
    if category not in CATEGORY_PLANTS:
        category = "shrubs"
    if state not in STATE_ZONES:
        state = "MN"

    plant_names = CATEGORY_PLANTS[category]
    zone = STATE_ZONES.get(state, "5a")

    try:
        trend_data = fetch_trends_data(plant_names, state)

        # Enrich with botanical names and filter out zero-score plants
        enriched = []
        for name, data in trend_data.items():
            if data.get("slope") in ("fetch_error", "insufficient_data", "no_data") and data.get("score", 0) == 0:
                continue
            lookup = PLANT_LOOKUP.get(name, {})
            enriched.append({
                "commonName": name,
                "botanicalName": lookup.get("botanical", ""),
                "trendScore": data.get("score", 0),
                "slope": data.get("slope", "stable"),
            })

        # Sort by trend score descending
        enriched.sort(key=lambda x: x["trendScore"], reverse=True)

        response_body = json.dumps({
            "success": True,
            "state": state,
            "zone": zone,
            "category": category,
            "plants": enriched,
        })

    except Exception as e:
        response_body = json.dumps({
            "success": False,
            "error": str(e),
            "state": state,
            "zone": zone,
            "category": category,
            "plants": [],
        })

    return {
        "statusCode": 200,
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*",
        },
        "body": response_body,
    }
